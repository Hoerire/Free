<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="io.github.hoerire.free.permission.REQUEST_ENTRY_CATALOG"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.hoerire.free.permission.REQUEST_ENTRY_CATALOG" />
    <!-- 仅用于读取 GitHub 最新发行版；hook 侧不发起任何网络请求。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用列表要列出全部已安装应用（排除列表按包名匹配）：没有这条，非桌面应用
         （如「耳机」com.oplus.melody）会被包可见性过滤掉，永远选不到。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <package android:name="com.coloros.smartsidebar" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".FreeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:description="@string/module_description"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Free">

        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true">
            <!--
                只带 MAIN、**不带 LAUNCHER**：桌面不会出现图标，但管理器仍可解析到它。
                关键是与 Xposed 模块约定一致：LSPosed 管理器找设置入口用的是
                MAIN + `de.robv.android.xposed.category.MODULE_SETTINGS` 这个类别
                （对照系统里其它模块的清单确认过）。少了这个类别，隐藏图标
                （禁用 LauncherAlias）后管理器仍然找不到入口。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!--
            快捷设置磁贴：隐藏桌面图标后 LSPosed 的模块入口也会消失（管理器按桌面入口解析），
            磁贴是此时唯一稳定的设置入口；需要用户自己在快捷设置里添加一次。
        -->
        <service
            android:name=".ui.SettingsTileService"
            android:exported="true"
            android:icon="@drawable/ic_settings_tile"
            android:label="@string/settings_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            桌面入口单独放在别名上：禁用别名即可隐藏桌面图标，
            主 Activity 仍然可以被设置里的「Free」条目用显式组件拉起。
        -->
        <activity-alias
            android:name=".LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
